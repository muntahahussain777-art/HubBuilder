<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Image Name="imgReceipt">
        <Source>Database</Source>
        <Value>=First(Fields!ReceiptImage.Value, "DataSet1")</Value>
        <MIMEType>image/png</MIMEType>
        <Sizing>Fit</Sizing>
        <Top>0in</Top>
        <Left>0in</Left>
        <Height>11.69in</Height>
        <Width>8.27in</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
        </Style>
      </Image>
    </ReportItems>
    <Height>11.69in</Height>
    <Style>
      <Border>
        <Style>None</Style>
      </Border>
    </Style>
  </Body>
  <Width>8.27in</Width>
  <Page>
    <PageHeight>11.69in</PageHeight>
    <PageWidth>8.27in</PageWidth>
    <LeftMargin>0in</LeftMargin>
    <RightMargin>0in</RightMargin>
    <TopMargin>0in</TopMargin>
    <BottomMargin>0in</BottomMargin>
    <ColumnSpacing>0in</ColumnSpacing>
    <Style />
  </Page>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="LasbelaVillageReceiptData">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>e7f8a9b0-c1d2-3456-7890-abcdef123456</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>LasbelaVillageReceiptData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="ReceiptImage">
          <DataField>ReceiptImage</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>f1a2b3c4-d5e6-7890-abcd-ef1234567890</rd:ReportID>
</Report>
